APP_NAME="Stock Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8003

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================
# DATABASE CONFIGURATION
# ==============================
DB_CONNECTION=mysql
DB_HOST=stock-db
DB_PORT=3306
DB_DATABASE=stock_db
DB_USERNAME=stock_user
DB_PASSWORD=stock_password

# ==============================
# JWT CONFIGURATION (Critical!)
# ==============================
# PENTING: JWT_SECRET harus SAMA dengan Shipping Service
# untuk shared authentication stateless
JWT_SECRET=shared_secret_stock_shipping_2024
JWT_EXPIRATION=1800
# Token lifetime: 30 menit (1800 detik)

# ==============================
# EXTERNAL API AUTHENTICATION
# ==============================
# API Key untuk akses eksternal (Product Service dari kelompok Toko)
EXTERNAL_API_KEY=stock_api_key_external_2024

# ==============================
# SERVICE CONFIGURATION
# ==============================
SERVICE_NAME="Stock Service"
SERVICE_PORT=8003

# ==============================
# MICROSERVICES URLs (Internal)
# ==============================
# Untuk komunikasi antar service dalam Docker network
SHIPPING_SERVICE_URL=http://shipping-service:8002/graphql

# ==============================
# GRAPHQL CONFIGURATION
# ==============================
LIGHTHOUSE_CACHE_ENABLE=false
LIGHTHOUSE_QUERY_CACHE_ENABLE=false

# ==============================
# CACHE & SESSION
# ==============================
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

